# Environment — copy to .env and fill in secrets

# ── Database ────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_code_review?schema=public"

# ── Auth ────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── App ─────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ────────────────────────────────────
# Comma-separated list of allowed origins (leave blank for *)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── File uploads ─────────────────────────────
# Max size per uploaded file in megabytes (default: 5)
MAX_FILE_SIZE_MB=5

# ── AI Provider Fallbacks (used when no active provider exists in DB) ──
# Provider type: groq | openai | lmstudio | ollama
AI_PROVIDER=groq
# Groq: https://api.groq.com/openai/v1 | OpenAI: https://api.openai.com/v1 | LM Studio: http://localhost:1234/v1 | Ollama: http://localhost:11434/v1
AI_BASE_URL="https://api.groq.com/openai/v1"
# API key (required for Groq / OpenAI, optional/placeholder for local LLMs)
AI_API_KEY="gsk_your_groq_key_here"
# Model identifier (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant, gpt-4o)
AI_MODEL="llama-3.3-70b-versatile"


